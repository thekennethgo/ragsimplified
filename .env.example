# Copy to .env and replace the fake values. Never commit .env.

# LLM (Storyteller, Fact-Checker, LLM-judged evals), see docs/adr/003-llm-provider.md
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=fake-key-replace-me

# Voyage AI (Translator embeddings, Judge reranker)
VOYAGE_API_KEY=pa-fake-key-replace-me

# Second look (ADR 006): set to off to skip the extra check after the Judge
SECOND_LOOK=on

# OpenRouter key for Mercury Decide, the free yes/no check in the second look (optional; without
# it the LLM decides alone)
OPENROUTER_API_KEY=sk-or-fake-key-replace-me

# Postgres with pgvector (local docker compose, or the Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragsimplified


# Frontend: where the backend lives
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend: browser origins allowed to call it (comma-separated)
CORS_ORIGINS=http://localhost:3000
