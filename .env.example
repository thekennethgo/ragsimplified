# Copy to .env and replace the fake values. Never commit .env.

# LLM (Storyteller, Fact-Checker, LLM-judged evals), see docs/adr/003-llm-provider.md
# Development: Gemini's free tier through its OpenAI-compatible endpoint (non-private text only).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=fake-key-replace-me
# Live site: LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-4-5-20251001 and this key.
ANTHROPIC_API_KEY=sk-ant-fake-key-replace-me

# Voyage AI (Translator embeddings, Judge reranker)
VOYAGE_API_KEY=pa-fake-key-replace-me

# Postgres with pgvector (local docker compose, or the Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragsimplified

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=pk-lf-fake-key-replace-me
LANGFUSE_SECRET_KEY=sk-lf-fake-key-replace-me
LANGFUSE_HOST=https://cloud.langfuse.com

# Secret token for the admin delete endpoint
ADMIN_TOKEN=fake-admin-token-replace-me

# Frontend: where the backend lives
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend: browser origins allowed to call it (comma-separated)
CORS_ORIGINS=http://localhost:3000
